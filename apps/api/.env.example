# Runtime
PORTFOLIO_API_ENVIRONMENT=development
PORTFOLIO_API_DEBUG=false
PORTFOLIO_API_LOG_LEVEL=INFO

# Database
# Local development with apps/api/compose.dev.yaml:
PORTFOLIO_API_DATABASE_URL=postgresql+asyncpg://portfolio_demo:portfolio_demo_local@127.0.0.1:5433/portfolio_demo

# Production example:
# PORTFOLIO_API_DATABASE_URL=postgresql+asyncpg://portfolio_demo:change-this-password@127.0.0.1:5432/portfolio_demo

# CORS
# Must be a JSON array.
# Local development:
PORTFOLIO_API_CORS_ORIGINS=["http://localhost:3000"]

# Production example:
# PORTFOLIO_API_CORS_ORIGINS=["https://your-domain.com"]

# Demo API limits
PORTFOLIO_API_DEMO_JSON_BODY_LIMIT_BYTES=65536
PORTFOLIO_API_DEMO_READ_RATE_LIMIT=60
PORTFOLIO_API_DEMO_WRITE_RATE_LIMIT=10
PORTFOLIO_API_DEMO_JOB_RATE_LIMIT=3
PORTFOLIO_API_DEMO_RATE_LIMIT_WINDOW_SECONDS=60

# Use a long random value in production.
# Generate example:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
PORTFOLIO_API_DEMO_RATE_LIMIT_SALT=portfolio-demo-development

# Demo job behavior
PORTFOLIO_API_DEMO_IDEMPOTENCY_TTL_HOURS=24
PORTFOLIO_API_DEMO_JOB_QUEUE_SECONDS=1.0
PORTFOLIO_API_DEMO_JOB_COMPLETION_SECONDS=4.0

# API docs
PORTFOLIO_API_DOCS_URL=/api/docs
PORTFOLIO_API_OPENAPI_URL=/api/openapi.json
