PORTFOLIO_API_APP_NAME=Portfolio Demo API
PORTFOLIO_API_APP_VERSION=1.0.0
PORTFOLIO_API_ENVIRONMENT=development
PORTFOLIO_API_DEBUG=false
PORTFOLIO_API_LOG_LEVEL=INFO

# Local development database only.
POSTGRES_DB=portfolio_demo
POSTGRES_USER=portfolio_demo
POSTGRES_PASSWORD=portfolio_demo_local

PORTFOLIO_API_DATABASE_URL=postgresql+asyncpg://portfolio_demo:portfolio_demo_local@127.0.0.1:5433/portfolio_demo
PORTFOLIO_API_DATABASE_ECHO=false
PORTFOLIO_API_DATABASE_POOL_SIZE=5
PORTFOLIO_API_DATABASE_MAX_OVERFLOW=5

# Pydantic Settings expects JSON for list values.
PORTFOLIO_API_CORS_ORIGINS=["http://localhost:3000"]
