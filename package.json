{
  "name": "khasandjon-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --dir apps/web dev",
    "build": "pnpm --dir apps/web build",
    "lint": "pnpm --dir apps/web lint",
    "typecheck": "pnpm --dir apps/web typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm api:test",
    "api:dev": "python -m uvicorn app.main:app --app-dir apps/api --reload",
    "api:test": "python -m pytest apps/api/tests",
    "api:lint": "python -m ruff check apps/api",
    "api:format": "python -m ruff format apps/api",
    "api:fix": "python -m ruff check apps/api --fix && python -m ruff format apps/api",
    "api:migrate": "cd apps/api && python -m alembic upgrade head",
    "api:seed": "cd apps/api && python -m app.db.seed_demo",
    "api:reset": "cd apps/api && python -m app.db.reset_demo",
    "content:validate": "pnpm --dir apps/web run content:validate",
    "content:report": "pnpm --dir apps/web run content:report",
    "docker:prod:build": "docker compose -f deploy/compose.prod.yaml --env-file deploy/.env build",
    "docker:prod:up": "docker compose -f deploy/compose.prod.yaml --env-file deploy/.env up -d",
    "docker:prod:down": "docker compose -f deploy/compose.prod.yaml --env-file deploy/.env down",
    "docker:prod:ps": "docker compose -f deploy/compose.prod.yaml --env-file deploy/.env ps",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm content:validate && pnpm build && pnpm api:lint && pnpm api:test"
  },
  "devDependencies": {
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0"
  }
}
