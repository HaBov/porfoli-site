{
  "name": "khasandjon-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --dir apps/web dev",
    "build": "pnpm --dir apps/web build",
    "lint": "pnpm --dir apps/web lint",
    "typecheck": "pnpm --dir apps/web typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:dev": "python -m uvicorn app.main:app --app-dir apps/api --reload",
    "api:test": "python -m pytest apps/api/tests",
    "api:lint": "python -m ruff check apps/api",
    "api:format": "python -m ruff format apps/api",
    "api:fix": "python -m ruff check apps/api --fix && python -m ruff format apps/api",
    "content:validate": "pnpm --dir apps/web run content:validate",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm content:validate && pnpm build && pnpm api:lint && pnpm api:test"
  },
  "devDependencies": {
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0"
  }
}
